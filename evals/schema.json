{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skill vs docs eval suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "skill",
    "description",
    "test_cases"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "skill": {
      "type": "string",
      "description": "Directory name under skills/ that this suite measures."
    },
    "description": {
      "type": "string"
    },
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "query",
          "why",
          "verified_against"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "query": {
            "type": "string",
            "description": "What a user would ask. Must not contain its own answer."
          },
          "why": {
            "type": "string",
            "description": "The fact under test and why a model would not already know it. Not graded."
          },
          "verified_against": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Public docs URLs or public source paths that confirm the fact. Not graded."
          },
          "required_patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "failure_patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "invariants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "failure_condition"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "failure_condition": {
                  "type": "string",
                  "description": "What fails, AND what passes."
                }
              }
            }
          },
          "origin": {
            "type": "string",
            "enum": [
              "docs-cited",
              "sampled",
              "targeted"
            ],
            "description": "How the case was picked. docs-cited: written from a published docs page, so it can only show the docs finding what they say. sampled: a claim taken from the skill without regard to the docs. targeted: a claim the author expected the docs to lack. Report verdicts per origin; never pool them."
          }
        },
        "anyOf": [
          {
            "required": [
              "required_patterns"
            ]
          },
          {
            "required": [
              "failure_patterns"
            ]
          },
          {
            "required": [
              "invariants"
            ]
          }
        ]
      }
    }
  }
}
